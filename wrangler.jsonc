{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "worldpulse",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "worldpulse-news",
      "database_id": "60f12b4b-91c3-47a0-aadc-36eb500d2e3e"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "NEWS_REFRESH_QUEUE",
        "queue": "worldpulse-news-refresh"
      }
    ],
    "consumers": [
      {
        "queue": "worldpulse-news-refresh",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 2
      }
    ]
  }
}
