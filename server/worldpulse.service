[Unit]
Description=WorldPulse continuous country news collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=worldpulse
Group=worldpulse
WorkingDirectory=/opt/worldpulse/server
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=384
Environment=PORT=80
Environment=WORLD_PULSE_CONCURRENCY=2
Environment=WORLD_PULSE_DATA_PATH=/var/lib/worldpulse/world-live.json
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/worldpulse

[Install]
WantedBy=multi-user.target
